# Copy to .env. Keep comments on their own lines: an inline comment after an
# empty value would be read as the value itself.

# --- App ---
# development | production
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db
# Raw API responses (lets the demo run offline)
CACHE_DIR=./data/cache
# Seed illustrative data and show "illustrative" badges
DEMO_MODE=true

# --- AI: Gemini (server-side only) ---
# From Google AI Studio; required for briefs, Ask the analyst, text signals
GEMINI_API_KEY=
# Quality model for briefs and chat. Pin an exact version before the demo
# (python -m scripts.cli models lists what your key can use).
GEMINI_MODEL=gemini-flash-latest
# Cheap/fast model for statement text-signal scoring
GEMINI_FAST_MODEL=gemini-flash-lite-latest
AI_MAX_OUTPUT_TOKENS=800
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=30

# --- Market data ---
# Optional: US 10Y (DGS10). If empty, UST10_FALLBACK is used
FRED_API_KEY=
# % : Friday 25 Sep 2026 close from team briefs
UST10_FALLBACK=5.17
# Bloomberg exports (spreads, CDS, local 10Y, FX)
MANUAL_INPUTS_CSV=./data/manual_inputs.csv
# Latest IMF WEO year to use
IMF_YEAR=2025
